# ==============================================================================
#                      CONFIGURACIÓN DEL BOT DE DISCORD (.env)
# ==============================================================================
# Renombra o copia este archivo como '.env' y completa con tus propios datos.
# NUNCA compartas ni subas tu archivo .env con tokens a repositorios públicos.

# ------------------------------------------------------------------------------
# 1. Credenciales y Tokens (Obligatorio)
# ------------------------------------------------------------------------------
# Token del bot generado en el Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=tu_discord_bot_token_aqui

# Prefijo de comando para invocar al bot (por defecto: %)
BOT_PREFIX=%

# ------------------------------------------------------------------------------
# 2. Permisos y Notificaciones Básicas
# ------------------------------------------------------------------------------
# Tu ID de usuario de Discord para comandos de administrador / control remoto del bot (%hablar)
OWNER_DISCORD_ID=0

# ID del canal donde el bot enviará un mensaje al iniciar y apagarse (opcional, 0 para desactivar)
IVY_ONLINE_CHANNEL_ID=0

# ID del rol a etiquetar con la Deadlock-Señal (%deadlock) (opcional, 0 para no etiquetar rol)
DEADLOCK_SIGNAL_ROLE_ID=0

# ------------------------------------------------------------------------------
# 3. Servicios Externos (APIs)
# ------------------------------------------------------------------------------
# API Key de Giphy Developers para el comando %gif (opcional)
GIPHY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Sistema de Economía y Timba
# ------------------------------------------------------------------------------
# ID del canal exclusivo donde se ejecutan los eventos aleatorios automáticos (Drops, Trivia, Raids, etc.)
ECONOMY_CHANNEL_ID=0

# ID del canal exclusivo para duelos (%duelo) y apuestas (%apostar). Deja en 0 para permitir en cualquier canal.
DUEL_CHANNEL_ID=0

# ID numérico del rol que se le otorgará automáticamente al usuario más rico del servidor (Top 1)
RICHEST_ROLE_ID=0

# Nombre del rol a buscar en caso de que RICHEST_ROLE_ID sea 0
RICHEST_ROLE_NAME=El Más Millonario

# ID del canal donde se publica el boletín diario del Más Millonario (opcional, 0 para desactivar)
RICHEST_ANNOUNCE_CHANNEL_ID=0

# Horario diario para publicar el boletín del Más Millonario en RICHEST_ANNOUNCE_CHANNEL_ID (Formato HH:MM en 24hs)
RICHEST_DAILY_ANNOUNCE_TIME=20:00

# ------------------------------------------------------------------------------
# 5. Ajustes Opcionales del Balance de Economía y Eventos
# ------------------------------------------------------------------------------
# Archivo de base de datos local para persistir usuarios y balances
DATA_FILE_PATH=stats.json

# Rango de minutos para el intervalo impredecible entre eventos (min y max)
EVENT_MIN_INTERVAL_MINUTES=15
EVENT_MAX_INTERVAL_MINUTES=30

# Probabilidad de disparo de un evento en cada ciclo (de 0.0 a 1.0, por ejemplo 0.5 = 50%)
EVENT_TRIGGER_CHANCE=0.5

# Probabilidades / Pesos de selección de eventos (Robin Hood y Lluvia al 5%, resto al 22.5%)
EVENT_WEIGHT_DROP=22.5
EVENT_WEIGHT_TRIVIA=22.5
EVENT_WEIGHT_RAID=22.5
EVENT_WEIGHT_ROULETTE=22.5
EVENT_WEIGHT_BOOST=5.0
EVENT_WEIGHT_ROBIN_HOOD=5.0

# Sistema Anti-Abuso para el Más Millonario (apuesta mínima de riesgo requerida)
MIN_RISK_BET_PERCENT=0.02
MIN_RISK_BET_FLOOR=500

# Escalamiento de probabilidad de Robin Hood por inactividad
INACTIVITY_STAGE_1_HOURS=24
EVENT_WEIGHT_ROBIN_HOOD_STAGE_1=15.0

INACTIVITY_STAGE_2_HOURS=48
EVENT_WEIGHT_ROBIN_HOOD_STAGE_2=30.0

INACTIVITY_STAGE_3_HOURS=72
EVENT_WEIGHT_ROBIN_HOOD_STAGE_3=50.0


# Ajustes de Blackjack (21)
BLACKJACK_PAYOUT_NORMAL=2.0
BLACKJACK_PAYOUT_NATURAL=2.5
BLACKJACK_TIMEOUT_SECONDS=60
BLACKJACK_DEALER_STAND=17

# ------------------------------------------------------------------------------
# 6. Tienda Callejera, Mercado Negro y Lotería
# ------------------------------------------------------------------------------
# Precios de artículos en tienda
ITEM_PRICE_COFFEE=2500
ITEM_PRICE_BAIL_BOND=5000
ITEM_PRICE_KUDZU_SEEDS=8000
ITEM_PRICE_LOCKPICK=12000
ITEM_PRICE_STONE_CHARM=20000
ITEM_PRICE_MEGAPHONE=35000
ITEM_PRICE_PARADOX_CHRONO=45000
PARADOX_REWIND_WINDOW_SECONDS=120

# Parámetros de efectos y duraciones
COFFEE_WORK_COOLDOWN=15
COFFEE_DURATION_SECONDS=1800
KUDZU_DURATION_SECONDS=86400
KUDZU_DROP_BONUS_PERCENT=0.50
LOCKPICK_FAIL_THRESHOLD=8

# Lotería y Gran Pozo Comunitario
LOTTERY_TICKET_PRICE=2000
LOTTERY_MAX_TICKETS_PER_USER=10
LOTTERY_BASE_JACKPOT=50000
LOTTERY_DRAW_TIME=21:00
LOTTERY_DRAW_DAY=6
